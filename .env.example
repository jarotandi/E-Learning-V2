# AKSA client environment.
#
# SECURITY: Do NOT add AI provider keys (GEMINI_API_KEY, GOOGLE_API_KEY, or any
# other provider secret) to this file or to any client-visible .env file.
# The client bundle must never receive provider credentials.
# AI provider integration is not active in the client. Future AI calls must use
# the AKSA server/edge AI Router boundary.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"